{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "skipLibCheck": true,
    "noEmit": true,
    "paths": {
      "react": [
        "./node_modules/@types/react"
      ],
      "react/jsx-runtime": [
        "./node_modules/@types/react/jsx-runtime"
      ],
      "@/*": [
        "./fixture/src/*"
      ],
      "react-dom": [
        "./node_modules/@types/react-dom"
      ]
    },
    "resolveJsonModule": true
  },
  "include": [
    "src",
    "fixture/src",
    "../skills/audit/canvas"
  ],
  "exclude": [
    "fixture/src/**/*.test.tsx"
  ]
}
